#ENZY_ACC_ID~GENE
map_enzy_to_gene <- function(enzy_acc_ids, species) {
  if (species == "mouse") {
    genes <- mapIds(org.Mm.eg.db, keys = enzy_acc_ids, column = "SYMBOL", keytype = "UNIPROT", multiVals = "first")
  } else if (species == "human") {
    genes <- mapIds(org.Hs.eg.db, keys = enzy_acc_ids, column = "SYMBOL", keytype = "UNIPROT", multiVals = "first")
  } else {
    stop("Species not supported")
  }
  return(genes)
}

