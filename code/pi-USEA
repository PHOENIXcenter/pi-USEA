df_DUBpre$GENE <- map_enzy_to_gene(df_DUBpre$ENZY_ACC_ID, "mouse")#"human"
unique_enzy_e3real <- unique(df_E3real$ENZY_ACC_ID)
unique_enzy_e3pre <- unique(df_E3pre$ENZY_ACC_ID)
unique_enzy_dubreal <- unique(df_DUBreal$ENZY_ACC_ID)
unique_enzy_dubpre <- unique(df_DUBpre$ENZY_ACC_ID)

get_info <- function(df, unique_enzy, suffix) {
  info <- df[df$ENZY_ACC_ID %in% unique_enzy, ]
  info <- info[, c("ENZY_ACC_ID", "GENE", "z_score", "p_value", "fdr")]
  colnames(info)[-1] <- paste0(colnames(info)[-1], "_", suffix)
  return(info)
}

info_e3real <- get_info(df_E3real, unique_enzy_e3real, "E3real")
info_e3pre <- get_info(df_E3pre, unique_enzy_e3pre, "E3pre")
info_dubreal <- get_info(df_DUBreal, unique_enzy_dubreal, "DUBreal")
info_dubpre <- get_info(df_DUBpre, unique_enzy_dubpre, "DUBpre")

merged_df <- Reduce(function(x, y) merge(x, y, by = "ENZY_ACC_ID", all = TRUE),
                    list(info_e3real, info_e3pre, info_dubreal, info_dubpre))

gene_cols <- grep("^GENE_", names(merged_df), value = TRUE)
merged_df$GENE <- apply(merged_df[gene_cols], 1, function(row) {
  genes <- unique(na.omit(unlist(row)))
  if (length(genes) == 0) NA_character_ else paste(genes, collapse = ", ")
})
priority_order <- c("GENE_E3real", "GENE_E3pre", "GENE_DUBreal", "GENE_DUBpre")

merged_df$GENE <- apply(merged_df[priority_order], 1, function(row) {
  valid_values <- na.omit(unlist(row))
  if (length(valid_values) == 0) NA_character_ else valid_values[1]
})

merged_df$GENE <- sapply(merged_df$GENE, function(x) {
  if (is.na(x)) return(NA)
  formatted <- strsplit(x, "-")[[1]] %>% 
    sapply(function(part) {
      if (nchar(part) == 0) return("")
      paste0(
        toupper(substring(tolower(part), 1, 1)),
        substring(tolower(part), 2)
      )
    }) %>% 
    paste(collapse = "-")
  formatted <- gsub("(\\bI{1,3}\\b|\\bIV\\b|\\bVI{0,3}\\b|\\bIX\\b|\\bXI{0,3}\\b)", 
                    "\\U\\1", formatted, perl = TRUE)
  
  return(formatted)
})

merged_df <- merged_df[ , !(names(merged_df) %in% priority_order)]
merged_df <- merged_df[c("ENZY_ACC_ID", "GENE", 
                         grep("z_score", names(merged_df), value = TRUE),
                         grep("p_value", names(merged_df), value = TRUE),
                         grep("fdr", names(merged_df), value = TRUE))]
merged_df <- distinct(merged_df)

write.csv(merged_df, "all_activity.csv", row.names = FALSE)

