####################################################################################
#E3real
result<- merge(x =E3real, y = exp_data, by.x = "SUB_ACC_ID", by.y = "SUB_ACC_ID")

ENZYME_stats <- result %>%
  group_by(ENZY_ACC_ID) %>%
  summarise(logFC_mean = mean(FC), logFC_count = n())
print(ENZYME_stats)
df_E3real <- left_join(result, ENZYME_stats, by = "ENZY_ACC_ID")
overall_summary <- result %>%
  summarise(
    overall_mean = mean(FC, na.rm = TRUE),  
    overall_sd = sd(FC, na.rm = TRUE)       
  )
print(overall_summary)

m <- overall_summary$overall_mean
s <- overall_summary$overall_sd

df_E3real$z_score <- (df_E3real$logFC_mean - m) * sqrt(df_E3real$logFC_count) / s

df_E3real$p_value <- 2*(1 - pnorm(abs(df_E3real$z_score)))
df_E3real$fdr <- p.adjust(df_E3real$p_value, method = "fdr") 
#################################################################
df_E3real<- df_E3real %>% select(where(~ !all(is.na(.))))
num_unique <- length(unique(df_E3real$ENZY_ACC_ID))
