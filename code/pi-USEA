  group_by(ENZY_ACC_ID, SUB_ACC_ID) %>%
  summarise(
    SUB_MOD_RSD = paste(unique(SUB_MOD_RSD), collapse = ", "),  
    .groups = 'drop'           
  ) %>%
  left_join(df_E3real, by = c("ENZY_ACC_ID", "SUB_ACC_ID")) %>%  
  distinct(ENZY_ACC_ID, SUB_ACC_ID, .keep_all = TRUE)  
df_E3real_final <- df_E3real_final %>%
  dplyr::select(-SUB_MOD_RSD.y)
df_E3real<- df_E3real_final
df_E3real<- df_E3real %>% dplyr::select(where(~ !all(is.na(.))))
num_unique <- length(unique(df_E3real$ENZY_ACC_ID))
print(num_unique)
write.csv(df_E3real, "E3_real_activity.csv", row.names = FALSE)


######################################################################################
#E3pre
E3pre <- E3pre %>%
  mutate(interScore = ifelse(is.na(interScore), 1, interScore))
#run：pre+real
#skip：pre

result<- merge(x =E3pre, y = exp_data, by.x = "SUB_ACC_ID", by.y = "SUB_ACC_ID")
na_count <- sum(is.na(result$interScore))

######################################################################
#Threshold evalute
df_E3pre<- result
Thresholds <- seq(0.5, 1, by = 0.01)
result_table <- map_df(Thresholds, function(Threshold) {
  filtered_data <- df_E3pre %>%
    filter(interScore >= Threshold)
  
  data.frame(
    Threshold = Threshold,
    num_unique_enzy = filtered_data %>% distinct(ENZY_ACC_ID) %>% nrow(),
    num_rows = nrow(filtered_data)
  )
})
optim_table <- result_table %>%
  mutate(
    scaled_unique = (num_unique_enzy - min(num_unique_enzy)) / 
      (max(num_unique_enzy) - min(num_unique_enzy)),
    scaled_rows = 1 - (num_rows - min(num_rows)) /  
      (max(num_rows) - min(num_rows)),
    composite_score = 1 * scaled_unique + 1 * scaled_rows
  ) 

best_Threshold <- optim_table %>% 
  arrange(desc(composite_score)) %>% 
  dplyr::slice(1)  

cat("Recommended threshold:", best_Threshold$Threshold, "\n",
    "Unique enzyme ID number:", best_Threshold$num_unique_enzy, "\n",
    "Unique Interaction number:", best_Threshold$num_rows, "\n\n")

optim_table %>%
  dplyr::select(Threshold, composite_score, num_unique_enzy, num_rows) %>%
  arrange(desc(composite_score)) %>%
  head(5) %>%
  knitr::kable(digits = 3)


p <- ggplot(optim_table, aes(x = Threshold)) +
  geom_line(aes(y = scaled_unique, color = "E3s")) +
  geom_line(aes(y = scaled_rows, color = "Interactions")) +
  geom_vline(xintercept = best_Threshold$Threshold, linetype = 5) +
  labs(title = "Trend of E3s and Interactions", y = "Scaled Value")
p

ggsave("trend_of_E3s_and_Interaction.png", plot = p, width = 10, height = 6, dpi = 300)
write.csv(result_table, "Threshold of E3 and Interaction.csv", row.names = FALSE)

