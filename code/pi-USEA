# Convert data to data.table
combined_df_real_dt <- data.table::as.data.table(combined_df_real)
data_E3_dt <- data.table::as.data.table(data_E3)

# Merge data, full outer join with suffixes
combined_df_pre_dt <- merge(
  combined_df_real_dt,
  data_E3_dt,
  by = c("ENZY_ACC_ID", "SUB_ACC_ID"),
  all = TRUE,
  suffixes = c("_real", "_pre")
)

# Mark rows that exist in real
combined_df_pre_dt[, exists_real := !is.na(source_real)]

# Get all column names with _pre suffix (except source_pre)
pre_cols <- grep("_pre$", names(combined_df_pre_dt), value = TRUE)
pre_cols <- pre_cols[pre_cols != "source_pre"]

# Set _pre columns to NA when real exists (except source_pre)
combined_df_pre_dt[exists_real == TRUE, (pre_cols) := NA]

# Merge source columns
combined_df_pre_dt[, source := {
  s_real <- source_real
  s_pre <- source_pre
  if (!is.na(s_real) & !is.na(s_pre)) {
    paste(s_real, s_pre, sep = ",")
  } else if (!is.na(s_real)) {
    s_real
  } else if (!is.na(s_pre)) {
    s_pre
  } else {
    NA_character_
  }
}, by = .I]

combined_df_pre_dt[
  grepl("UbiBrowser_pre", source) & grepl(",", source),
  interScore := NA_real_
]

# Output results
print(combined_df_pre_dt)
write.csv(combined_df_pre_dt, "E3pre.csv", row.names = FALSE)

